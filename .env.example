# Salin menjadi .env (JANGAN di-commit). Semua nilai di bawah adalah PLACEHOLDER.
# Tanpa file .env, docker compose memakai nilai default pengembangan.

# ---- Umum ----
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME   # Neon: tambahkan ?sslmode=require
DISCOVERY=static                  # 'dns' untuk Docker Compose, 'static' untuk Render (URL publik)
ENFORCE_SECRETS=false             # WAJIB true pada deployment publik: service menolak start bila secret default/lemah
LOG_REQUESTS=true
TRUST_PROXY=1                     # isi 1 di balik proxy platform (Render) agar IP klien benar untuk rate limit

# ---- Auth ----
AUTH_ISSUER=ticketing-auth
AUTH_AUDIENCE=ticketing-api
AUTH_JWKS_URL=https://AUTH-SERVICE-HOST/.well-known/jwks.json
AUTH_SERVICE_URLS=https://AUTH-SERVICE-HOST
JWT_PRIVATE_JWK_B64=              # hasil: npm run gen:jwk  (wajib di produksi)
ACCESS_TOKEN_TTL_SECONDS=900
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=GANTI-DENGAN-PASSWORD-KUAT
ORDER_SERVICE_CLIENT_SECRET=GANTI-DENGAN-SECRET-ACAK-PANJANG

# ---- URL antarlayanan ----
EVENT_SERVICE_URLS=https://EVENT-SERVICE-HOST     # boleh beberapa, dipisah koma
ORDER_SERVICE_URLS=https://ORDER-SERVICE-HOST

# ---- Gateway ----
REDIS_URL=rediss://default:PASSWORD@HOST:6379     # WAJIB untuk order-service dan worker (message queue); gateway: opsional (tanpa ini rate limit memakai memori lokal)
CORS_ORIGINS=                                     # daftar origin dipisah koma; kosong = CORS dimatikan
GATEWAY_BODY_LIMIT_BYTES=102400
UPSTREAM_TIMEOUT_MS=10000
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_AUTH_PER_5MIN=20
RATE_LIMIT_EVENTS_PER_MIN=120
RATE_LIMIT_GRAPHQL_PER_MIN=60
RATE_LIMIT_ORDER_PER_MIN=10
RATE_LIMIT_ORDER_READ_PER_MIN=60

# ---- Worker / message queue ----
WORKER_CONCURRENCY=1              # jumlah order diproses bersamaan per worker (1 = satu per satu)
ORDER_JOB_ATTEMPTS=5              # percobaan per job sebelum masuk dead-letter
ORDER_JOB_BACKOFF_MS=2000         # jeda awal retry (exponential)
ORDER_SWEEP_INTERVAL_MS=30000     # seberapa sering sweeper mencari order PENDING yang tertinggal
ORDER_STALE_SECONDS=60            # order PENDING lebih tua dari ini dianggap tertinggal

# ---- Order / Event ----
MAX_TICKETS_PER_ORDER=4
GRAPHQL_MAX_DEPTH=5
GRAPHQL_MAX_FIELDS=100
PG_POOL_MAX=10
